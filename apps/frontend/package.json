    "react-full-screen": "^1.1.1",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-player": "^3.4.0",
    "react-redux": "^9.3.1",
    "react-responsive-masonry": "^2.9.0",
    "react-slick": "^0.31.0",
    "react-syntax-highlighter": "^16.1.2",
    "redux": "^5.0.1",
    "sanity": "^6.23.0",
    "sanity-codegen": "^0.9.8",
